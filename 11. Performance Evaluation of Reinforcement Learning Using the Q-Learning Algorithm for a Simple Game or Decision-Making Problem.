# Practical No. 11
# Title: Performance Evaluation of Reinforcement Learning Using Q-Learning Algorithm for Grid World Environment

import numpy as np
import random

# Initialize Grid World
states = 16
actions = 4

# Create Q-Table
Q = np.zeros((states, actions))

# Learning Parameters
alpha = 0.1
gamma = 0.9
epsilon = 0.1
episodes = 1000

# Training
for episode in range(episodes):

    state = random.randint(0, 14)

    while state != 15:

        # Epsilon-Greedy Strategy
        if random.uniform(0, 1) < epsilon:
            action = random.randint(0, 3)
        else:
            action = np.argmax(Q[state])

        # Next State
        next_state = min(state + 1, 15)

        # Reward
        reward = 100 if next_state == 15 else -1

        # Q-Learning Update
        Q[state, action] = Q[state, action] + alpha * (
            reward + gamma * np.max(Q[next_state])
            - Q[state, action]
        )

        state = next_state

# Display Q-Table
print("Q Table:")
print(Q)

# Generate Optimal Policy
policy = np.argmax(Q, axis=1)

print("\nOptimal Policy:")
print(policy)

# Display Action Names
action_names = ["Up", "Down", "Left", "Right"]

print("\nOptimal Actions:")
for i in range(states):
    if i == 15:
        print("State", i, ": Goal")
    else:
        print("State", i, ":", action_names[policy[i]])
